  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FirstPersonSystem.Narrative.QuestManager
  defaultQuestTitle: Lay your wife to rest
  defaultQuestObjective: Carry and place the coffin at the summit marker.
  summitRestingTarget: {fileID: 0}
  completionDistance: 6
  returnToStartSceneOnComplete: 1
  returnToStartSceneDelay: 10
  startSceneName: Start
  questTriggeredSound: {fileID: 0}
  questCompletedSound: {fileID: 0}
--- !u!114 &836969579
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 836969572}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8d4f2a1c990f34444845438ee6480cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FirstPersonSystem.Narrative.NarrativeTriggerManager
  playerTransform: {fileID: 0}
  coffinTransform: {fileID: 2076353275}
  mountainGenerator: {fileID: 0}
  fallbackProfile: {fileID: 0}
  milestone1Sequence:
    sequenceId: Milestone_1
    title: 'Milestone 1: First Movement (The Wish & The Climb)'
    lines:
    - speaker: Mary's Letter
      subtitleText: 'My love, if you are reading this, then I am no longer with you.
        Yet I have one last wish from you: let me rest on the mountain''s top. It
        is a steep and punishing climb, but use the heavy trees along the path to
        anchor your line, and bring me to the sky.'
      voiceClip: {fileID: 8300000, guid: 24ed73271c2dfcd4ea3182df06eb9a8f, type: 3}
      customDuration: 0
      pauseAfter: 1
    triggerQuest: 0
    questTitle: Lay Your Wife to Rest
    questObjective: Carry and place the coffin at the summit marker.
  milestone2Sequence:
    sequenceId: Milestone_2
    title: 'Milestone 2: First Anchor Placed (The Worth of Limited Time)'
    lines:
    - speaker: Mary's Letter
      subtitleText: "We didn't get a lifetime of years together, but every single
        second we shared meant the entire world to me. A love isn't measured by how
        long it endures, but by how deeply it was felt\u2014and what we had was worth
        every heartbeat, even if our time was short."
      voiceClip: {fileID: 8300000, guid: a6feeffca35e9ca4c8c902f4d9075e44, type: 3}
      customDuration: 0
      pauseAfter: 1
    triggerQuest: 0
    questTitle: Lay Your Wife to Rest
    questObjective: Carry and place the coffin at the summit marker.
  milestone3Sequence:
    sequenceId: Milestone_3
    title: "Milestone 3: Safe Zone 1 (~20% Elevation \u2014 The Confession)"
    lines:
    - speaker: Mary's Letter
      subtitleText: I am so sorry I didn't tell you what was coming. I knew my time
        was slipping away, that these past few days were our very last, and keeping
        that secret was the heaviest burden I have ever carried.
      voiceClip: {fileID: 8300000, guid: c8dc43af8d93aa742b5c268426ca380e, type: 3}
      customDuration: 0
      pauseAfter: 1
    triggerQuest: 0
    questTitle: Lay Your Wife to Rest
    questObjective: Carry and place the coffin at the summit marker.
  milestone4Sequence:
    sequenceId: Milestone_4
    title: "Milestone 4: Safe Zone 2 (~40% Elevation \u2014 Choosing Joy Over Anticipated
      Grief)"
    lines:
    - speaker: Mary's Letter
      subtitleText: "I couldn\u2019t bear the thought of watching our final days
        turn into mourning before I was even gone. I didn't want our hours poisoned
        by fear or counting down the clock; I just wanted to live with you, truly
        and happily, right until the quiet took me."
      voiceClip: {fileID: 8300000, guid: 1c7d37ce07b649c459ff43febbaa1737, type: 3}
      customDuration: 0
      pauseAfter: 1
    triggerQuest: 0
    questTitle: Lay Your Wife to Rest
    questObjective: Carry and place the coffin at the summit marker.
  milestone5Sequence:
    sequenceId: Milestone_5
    title: "Milestone 5: Safe Zone 3 (~60% Elevation \u2014 Forgiveness & Sacred
      Days)"
    lines:
    - speaker: Mary's Letter
      subtitleText: "I pray you can forgive me for hiding it. Knowing our ending
        didn't make our days together mean any less\u2014it made every cup of coffee,
        every shared look, and every laugh across our table sacred. I would choose
        those short, fleeting days with you a thousand times over."
      voiceClip: {fileID: 8300000, guid: f1573734a635edd48bb0387fb5dd16b3, type: 3}
      customDuration: 0
      pauseAfter: 1
    triggerQuest: 0
    questTitle: Lay Your Wife to Rest
    questObjective: Carry and place the coffin at the summit marker.
  milestone6Sequence:
    sequenceId: Milestone_6
    title: "Milestone 6: Safe Zone 4 (~80% Elevation \u2014 The Peak in View)"
    lines:
    - speaker: Mary's Letter
      subtitleText: Look how high your love has carried us; the trees are parting,
        and the entire valley is glowing below. The climb is almost over, my darling.
        Catch your breath, and give me one last pull to the ridge.
      voiceClip: {fileID: 8300000, guid: c432cdefbc70f364bac9f6146a8944e0, type: 3}
      customDuration: 0
      pauseAfter: 1
    triggerQuest: 0
    questTitle: Lay Your Wife to Rest
    questObjective: Carry and place the coffin at the summit marker.
  milestone7Sequence:
    sequenceId: Milestone_7
    title: 'Milestone 7: Final Area (The Rest & Farewell)'
    lines:
    - speaker: Mary's Letter
      subtitleText: Now is the time for me to rest. And remember that our ending
        doesn't erase the beauty of what we had. Thank you for everything, my love.
        Goodbye.
      voiceClip: {fileID: 8300000, guid: 5b5a04f85b96fc74e8c5b83b83c5ae38, type: 3}
      customDuration: 0
      pauseAfter: 1
    triggerQuest: 0
    questTitle: Lay Your Wife to Rest
    questObjective: Carry and place the coffin at the summit marker.
